# ====================================================================
# EXPORTRACE BACKEND - ENVIRONMENT VARIABLES
# ====================================================================
PORT=8080

# SQLite Database (o PostgreSQL para producción en Render/Cloud)
# En desarrollo: jdbc:sqlite:exportrace.db
# En producción con PostgreSQL: jdbc:postgresql://dpg-xxxx.render.com/exportrace_db
SPRING_DATASOURCE_URL=jdbc:sqlite:exportrace.db

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://exportrace-frontend.onrender.com

# Seguridad JWT
JWT_SECRET=9a4f2c8d7b6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0
JWT_EXPIRATION=86400000

# Almacenamiento de Archivos y Evidencias Fotográficas
# En desarrollo: ./uploads
# En producción (Render con Persistent Disk): /var/data/uploads o ./uploads
FILE_STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Contraseña inicial de SuperAdmin
SUPERADMIN_INITIAL_PASSWORD=SuperAdmin2026!

# ====================================================================
# INTEGRACIÓN JIRA SERVICE MANAGEMENT CLOUD (FASE C - PLACEHOLDERS)
# ====================================================================
# Por defecto deshabilitado (false) en desarrollo local.
# NUNCA subir credenciales reales ni API Tokens al repositorio.
JIRA_ENABLED=false
JIRA_BASE_URL=https://TU-DOMINIO.atlassian.net
JIRA_SERVICE_DESK_ID=XX
JIRA_REQUEST_TYPE_ID=XX
JIRA_ACCOUNT_EMAIL=cuenta-integracion@example.com
JIRA_API_TOKEN=***
JIRA_CORRELATION_FIELD_ID=customfield_XXXXX
JIRA_EXPORTRACE_CODE_FIELD_ID=
JIRA_CONNECT_TIMEOUT_SECONDS=5
JIRA_READ_TIMEOUT_SECONDS=10
